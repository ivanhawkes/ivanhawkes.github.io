{
    "name": "ivan-hawkes-blog",
    "version": "1.0.0",
    "description": "A blog for a human.",
    "author": "Ivan Hawkes",
    "scripts": {
        "css": "tailwindcss -i themes/be-best/assets/css/main.css -o assets/css/main.css",
        "css-watch": "tailwindcss -i themes/be-best/assets/css/main.css -o assets/css/main.css --watch",
        "serve": "pnpm run css && hugo server -D -F --gc --cleanDestinationDir",
        "build:css": "tailwindcss -i themes/be-best/assets/css/main.css -o assets/css/main.css --minify",
        "build:hugo": "hugo build --gc --minify --cleanDestinationDir",
        "build": "pnpm run build:css && pnpm run build:hugo",
        "test:css": "tailwindcss -i themes/be-best/assets/css/main.css -o assets/css/main.css",
        "test:hugo": "hugo build --gc --cleanDestinationDir",
        "test": "pnpm run test:css && pnpm run serve:hugo",
        "prepare": "husky",
        "format": "prettier --write \"**/*.{js,ts,json,css,md,html,yaml}\""
    },
    "prettier": {
        "printWidth": 80,
        "useTabs": false,
        "tabWidth": 4,
        "trailingComma": "es5",
        "semi": true,
        "singleQuote": true,
        "bracketSpacing": true,
        "bracketSameLine": true,
        "goTemplateBracketSpacing": true,
        "htmlWhitespaceSensitivity": "ignore",
        "arrowParens": "always",
        "proseWrap": "always",
        "plugins": [
            "prettier-plugin-tailwindcss",
            "prettier-plugin-go-template"
        ],
        "tailwindStylesheet": "./assets/css/main.css",
        "overrides": [
            {
                "files": ".prettierrc",
                "options": {
                    "parser": "json"
                }
            },
            {
                "files": [
                    "*.html"
                ],
                "options": {
                    "parser": "go-template"
                }
            },
            {
                "files": "*.yaml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.9",
        "prettier-plugin-go-template": "^0.0.15",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-tailwindcss": "^1.0.1",
        "tailwindcss": "^4.3.3"
    },
    "lint-staged": {
        "*.{js,ts,json,css,md,html,yaml}": "prettier --write"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.1": true
    }
}
