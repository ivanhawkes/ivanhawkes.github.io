{
  "name": "Ivan Hawkes - Blog",
  "version": "1.0.0",
  "description": "A blog for a human.",
  "author": "Ivan Hawkes",
  "workspaces": [
    "themes/**"
  ],
  "scripts": {
    "build-css": "npx @tailwindcss/cli -i themes/be-best/assets/css/main.css -o public/css/main.css --watch"
  },
  "dependencies": {
  },
  "devDependencies": {
  },
  "prettier": {
    "max_line_length": 80,
    "printWidth": 80,
    "useTabs": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true,
    "bracketSpacing": true,
    "bracketSameLine": true,
    "goTemplateBracketSpacing": true,
    "htmlWhitespaceSensitivity": "ignore",
    "arrowParens": "always",
    "proseWrap": "always",
    "indentTables": true,
    "indentEntries": true,
    "alignEntries": true,
    "reorderKeys": false,
    "plugins": [
      "prettier-plugin-tailwindcss",
      "prettier-plugin-go-template"
    ],
    "tailwindStylesheet": "./assets/css/main.css",
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[xml]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "overrides": [
      {
        "files": ".prettierrc",
        "options": {
          "parser": "json"
        }
      },
      {
        "files": [
          "*.html"
        ],
        "options": {
          "parser": "go-template"
        }
      }
    ]
  }
}