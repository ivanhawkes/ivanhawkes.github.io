{
    "name": "ivan-hawkes-blog",
    "version": "1.0.0",
    "description": "A blog for a human.",
    "author": "Ivan Hawkes",
    "scripts": {
        "css": "tailwindcss -i be-best/assets/css/main.css -o assets/css/main.css",
        "css-watch": "tailwindcss -i be-best/assets/css/main.css -o assets/css/main.css --watch",
        "server": "pnpm run css && hugo server -D -F --bind 0.0.0.0 --baseURL http://${HOST:-$(hostname)}:1313",
        "build:css": "tailwindcss -i be-best/assets/css/main.css -o assets/css/main.css --minify",
        "build:hugo": "hugo build --gc --minify --cleanDestinationDir",
        "build": "pnpm run build:css && pnpm run build:hugo",
        "test:css": "tailwindcss -i be-best/assets/css/main.css -o assets/css/main.css",
        "lint": "pnpm run test:lint",
        "lint:fix": "eslint --fix \"scripts/**/*.mjs\" \"be-best/assets/js/**/*.ts\" \"eslint.config.mjs\" \"be-best/*.config.mjs\"",
        "test:lint": "eslint \"scripts/**/*.mjs\" \"be-best/assets/js/**/*.ts\" \"eslint.config.mjs\" \"be-best/*.config.mjs\"",
        "test:hugo": "hugo build --cleanDestinationDir",
        "test:html": "html-validate \"public/**/*.html\"",
        "test:headings": "node scripts/validate-headings.mjs",
        "test:placeholders": "node scripts/validate-placeholders.mjs",
        "test:kanban": "node scripts/validate-kanban-front-matter.mjs",
        "test:methods": "node scripts/validate-recipe-method.mjs",
        "test:jsonld": "node scripts/validate-recipe-jsonld.mjs",
        "test:prettier": "node scripts/validate-prettier-setup.mjs",
        "test:checks": "pnpm run test:lint && pnpm run test:html && pnpm run test:headings && pnpm run test:placeholders && pnpm run test:kanban && pnpm run test:methods && pnpm run test:jsonld && pnpm run test:prettier",
        "test": "pnpm run test:css && pnpm run test:hugo && pnpm run test:checks",
        "test:ci": "pnpm run test:checks && go test ./cmd/kan",
        "prepare": "husky",
        "format": "prettier --write \"**/*.{js,ts,json,css,md,html,yaml}\""
    },
    "prettier": {
        "printWidth": 80,
        "useTabs": false,
        "tabWidth": 4,
        "trailingComma": "es5",
        "semi": true,
        "singleQuote": true,
        "bracketSpacing": true,
        "bracketSameLine": true,
        "htmlWhitespaceSensitivity": "ignore",
        "arrowParens": "always",
        "proseWrap": "always",
        "overrides": [
            {
                "files": [
                    "**/*.css"
                ],
                "options": {
                    "printWidth": 100
                }
            },
            {
                "files": "*.yaml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "devDependencies": {
        "@eslint/css": "^2.0.1",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@eslint/markdown": "^8.0.3",
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "html-validate": "^11.17.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-tailwindcss": "^1.0.1",
        "tailwindcss": "^4.3.3",
        "typescript-eslint": "^8.72.0",
        "yaml": "^2.9.1"
    },
    "lint-staged": {
        "*.{js,ts,json,css,md,html,yaml}": "prettier --write"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.1": true
    }
}
